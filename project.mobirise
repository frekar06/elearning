      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              ".svg-top": {
                "display": "none"
              }
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".svg-container": {
              "position": "absolute",
              "top": "0",
              "width": "100%",
              "overflow": "hidden",
              "height": "300px"
            },
            "svg": {
              "position": "absolute",
              "top": "50px",
              "width": "1700px",
              "right": "-80px",
              "transform": "scaleX(1) scaleY(1.3) rotate(0deg)",
              "path": {
                "fill": "@svgColor"
              },
              "animation": "1.5s ease-in-out infinite alternate svg",
              "@media (max-width: 992px)": {
                "width": "1500px"
              },
              "@media (max-width: 767px)": {
                "width": "800px"
              }
            },
            "@keyframes svg": {
              "from": {
                "transform": "scaleX(1.2) scaleY(1.35) rotate(-1deg)"
              },
              "to": {
                "transform": "scaleX(1) scaleY(1.3) rotate(0deg)"
              }
            },
            ".mbr-section-title": {
              "color": "#1a449a"
            },
            "@media (min-width: 1400px)": {
              ".col-12": {
